rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'jaopangan.oligarchmedia@gmail.com' ||
        request.auth.token.email_verified == true
      );
    }

    // Standalone Validation Blueprint for Projects
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'coverImage', 'images', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'folderName', 'parentFolder', 'subFolder', 'tagline',
          'category', 'coverImage', 'images', 'description', 'client', 'role',
          'year', 'tools', 'likes', 'views', 'isLiked', 'featured', 'behanceUrl',
          'liveUrl', 'challenges', 'solution', 'palette', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.coverImage is string && data.coverImage.size() <= 500000 &&
        data.images is list && data.images.size() <= 50 &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        (!('folderName' in data) || (data.folderName is string && data.folderName.size() <= 200)) &&
        (!('parentFolder' in data) || (data.parentFolder is string && data.parentFolder.size() <= 200)) &&
        (!('subFolder' in data) || (data.subFolder is string && data.subFolder.size() <= 200)) &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 10000)) &&
        (!('client' in data) || (data.client is string && data.client.size() <= 200)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 200)) &&
        (!('year' in data) || (data.year is string && data.year.size() <= 50)) &&
        (!('tools' in data) || (data.tools is list && data.tools.size() <= 30)) &&
        (!('palette' in data) || (data.palette is list && data.palette.size() <= 20)) &&
        (!('likes' in data) || (data.likes is number)) &&
        (!('views' in data) || (data.views is number)) &&
        (!('isLiked' in data) || (data.isLiked is bool)) &&
        (!('featured' in data) || (data.featured is bool)) &&
        (!('behanceUrl' in data) || (data.behanceUrl is string && data.behanceUrl.size() <= 500)) &&
        (!('liveUrl' in data) || (data.liveUrl is string && data.liveUrl.size() <= 500)) &&
        (!('challenges' in data) || (data.challenges is string && data.challenges.size() <= 5000)) &&
        (!('solution' in data) || (data.solution is string && data.solution.size() <= 5000)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Standalone Validation Blueprint for Client Direct Messages
    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'senderName', 'senderEmail', 'subject', 'message', 'createdAt']) &&
        data.keys().hasOnly(['id', 'senderName', 'senderEmail', 'subject', 'inquiryType', 'message', 'createdAt', 'isRead']) &&
        data.id is string && data.id.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
        data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 200 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 5000 &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        (!('inquiryType' in data) || (data.inquiryType is string && data.inquiryType.size() <= 100)) &&
        (!('isRead' in data) || (data.isRead is bool));
    }

    // Standalone Validation Blueprint for User Profile
    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'email', 'headline']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.headline is string && data.headline.size() <= 200 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 5000)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500000)) &&
        (!('coverBanner' in data) || (data.coverBanner is string && data.coverBanner.size() <= 500000)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
        (!('availableForWork' in data) || (data.availableForWork is bool)) &&
        (!('availabilityNote' in data) || (data.availabilityNote is string && data.availabilityNote.size() <= 200));
    }

    // Projects Collection: Public read, owner full write, public interaction (likes/views)
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isValidId(projectId) && isValidProject(incoming());
      allow update: if isValidId(projectId) && isValidProject(incoming()) && (
        isOwner() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'views'])
      );
      allow delete: if isValidId(projectId) && isOwner();
    }

    // Messages Collection: Client inquiries submitted via Contact Me
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow read, update, delete: if isOwner();
    }

    // Profile Document: Public read, owner update
    match /profile/{profileId} {
      allow read: if true;
      allow write: if isValidId(profileId) && isValidProfile(incoming());
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
